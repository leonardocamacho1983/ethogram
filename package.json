{
  "name": "ethogram",
  "version": "0.1.0-alpha.0",
  "description": "Local, code-first behavioral testing for TypeScript and Node.js agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardocamacho1983/ethogram.git"
  },
  "homepage": "https://github.com/leonardocamacho1983/ethogram#readme",
  "bugs": {
    "url": "https://github.com/leonardocamacho1983/ethogram/issues"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "tests/fixtures/external-agent-project"
  ],
  "scripts": {
    "core:build": "tsc -p packages/agentbook/tsconfig.build.json && tsc -p packages/agentbook/tsconfig.cjs.json && node packages/agentbook/scripts/finish-cjs-build.mjs",
    "cli:build": "npm run build -w @ethogram/cli",
    "test:package": "node --test tests/installable-package-boundary.test.mjs",
    "test:onboarding": "node --test tests/five-minute-developer-onboarding.integration.mjs",
    "test:existing-agent": "node --test tests/bring-your-own-agent.integration.mjs",
    "test:third-party-agent": "npm run core:build && npm run cli:build && node tests/real-third-party-agent.integration.mjs",
    "stories:discover": "node scripts/generate-story-registry.mjs",
    "predev": "npm run core:build && node scripts/generate-story-registry.mjs",
    "dev": "next dev",
    "prebuild": "npm run core:build && npm run cli:build && node scripts/generate-story-registry.mjs",
    "build": "next build --webpack",
    "pretypecheck": "npm run core:build && npm run cli:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run core:build && npm run cli:build",
    "test": "node --test tests/*.test.mjs",
    "test:real-agent": "node --test tests/real-agent-runner.integration.mjs",
    "test:seo:schemas": "node scripts/validate-seo-schema.mjs",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "ai": "^7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@github-tools/sdk": "1.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
